<?xml version="1.0" encoding="utf-8"?>
<!-- Ruta real: views/account_tax_views.xml -->
<odoo>

    <record id="view_tax_form_tf_dte_cl" model="ir.ui.view">
        <field name="name">account.tax.form.tf_dte_cl</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type_tax_use']" position="after">
                <field name="tf_dte_cl_sii_code" invisible="type_tax_use != 'sale'"/>
            </xpath>
        </field>
    </record>

</odoo>
