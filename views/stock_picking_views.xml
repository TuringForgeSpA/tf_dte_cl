<?xml version="1.0" encoding="utf-8"?>
<!-- Ruta real: views/stock_picking_views.xml -->
<odoo>

    <record id="view_picking_type_form_tf_dte_cl" model="ir.ui.view">
        <field name="name">stock.picking.type.form.tf_dte_cl</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='second']" position="inside">
                <field name="tf_dte_cl_document_type" invisible="code not in ('outgoing', 'internal')"/>
                <field name="tf_dte_cl_branch_id" invisible="not tf_dte_cl_document_type"
                       options="{'no_create': True}"/>
                <field name="tf_dte_cl_transfer_type" invisible="not tf_dte_cl_document_type"/>
                <field name="tf_dte_cl_dispatch_type" invisible="not tf_dte_cl_document_type"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_form_tf_dte_cl" model="ir.ui.view">
        <field name="name">stock.picking.form.tf_dte_cl</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="/form/header" position="inside">
                <field name="tf_dte_cl_is_dte" invisible="1"/>
                <button name="action_tf_dte_cl_query" type="object" string="Consultar SII"
                        invisible="tf_dte_cl_state not in ('sent', 'send_unknown')"/>
                <button name="action_tf_dte_cl_retry" type="object" string="Reintentar guía"
                        class="btn-secondary" invisible="tf_dte_cl_state != 'error'"/>
                <button name="action_tf_dte_cl_reset" type="object" string="Restablecer guía"
                        class="btn-danger" groups="tf_dte_cl.group_tf_dte_cl_manager"
                        invisible="tf_dte_cl_state != 'rejected'"
                        confirm="El folio actual quedará registrado para anulación y la guía se emitirá con un folio nuevo. ¿Continuar?"/>
            </xpath>

            <!-- Guía de despacho bajo el título; la referencia de Odoo no cambia. -->
            <xpath expr="//div[hasclass('oe_title')]/h1" position="after">
                <div class="fs-5 mb-2" invisible="not tf_dte_cl_is_dte">
                    <span invisible="not tf_dte_cl_folio">
                        <field name="tf_dte_cl_title" readonly="1" class="oe_inline fw-bold"/>
                        <field name="tf_dte_cl_state" widget="badge" readonly="1" class="ms-2"
                               decoration-success="tf_dte_cl_state in ('accepted', 'accepted_objections')"
                               decoration-info="tf_dte_cl_state in ('signed', 'sent')"
                               decoration-warning="tf_dte_cl_state == 'send_unknown'"
                               decoration-danger="tf_dte_cl_state in ('rejected', 'error')"/>
                    </span>
                    <span class="text-muted" invisible="tf_dte_cl_folio or state in ('done', 'cancel')">
                        El folio SII de la guía se asignará al validar la entrega.
                    </span>
                </div>
            </xpath>

            <xpath expr="/form/sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not tf_dte_cl_error or tf_dte_cl_state in ('accepted', 'accepted_objections')">
                    <strong>Guía de despacho: </strong><field name="tf_dte_cl_error" readonly="1"/>
                </div>
                <div class="alert alert-danger mb-0" role="alert" invisible="tf_dte_cl_state != 'rejected'">
                    <strong>El SII rechazó esta guía. </strong>
                    <field name="tf_dte_cl_sii_detail" readonly="1"/>
                </div>
            </xpath>

            <xpath expr="/form/sheet/notebook" position="inside">
                <page name="tf_dte_cl_guide" string="Guía de despacho" invisible="not tf_dte_cl_is_dte">
                    <group>
                        <group string="Traslado">
                            <field name="tf_dte_cl_transfer_type" required="tf_dte_cl_is_dte"
                                   readonly="state in ('done', 'cancel')"/>
                            <field name="tf_dte_cl_dispatch_type" required="tf_dte_cl_is_dte"
                                   readonly="state in ('done', 'cancel')"/>
                            <field name="tf_dte_cl_carrier_id" options="{'no_create': True}"
                                   required="tf_dte_cl_dispatch_type == '3'"
                                   readonly="state in ('done', 'cancel')"/>
                            <field name="tf_dte_cl_vehicle_plate" readonly="state in ('done', 'cancel')"/>
                            <field name="tf_dte_cl_driver_rut" readonly="state in ('done', 'cancel')"/>
                            <field name="tf_dte_cl_driver_name" required="tf_dte_cl_driver_rut"
                                   readonly="state in ('done', 'cancel')"/>
                        </group>
                        <group string="Destino">
                            <field name="tf_dte_cl_dest_street" readonly="state in ('done', 'cancel')"/>
                            <field name="tf_dte_cl_dest_comuna_id" options="{'no_create': True}"
                                   readonly="state in ('done', 'cancel')"/>
                            <field name="tf_dte_cl_dest_city" readonly="state in ('done', 'cancel')"/>
                        </group>
                    </group>
                    <separator string="Referencias SII"/>
                    <field name="tf_dte_cl_reference_ids" readonly="state in ('done', 'cancel')">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="document_type_id" options="{'no_create': True}"/>
                            <field name="document_type_kind" column_invisible="True"/>
                            <field name="folio" required="not is_global"/>
                            <field name="date"/>
                            <field name="code"/>
                            <field name="reason"/>
                            <field name="is_global" optional="hide"/>
                        </list>
                    </field>
                    <group string="Estado DTE" invisible="not tf_dte_cl_state">
                        <group>
                            <field name="tf_dte_cl_folio"/>
                            <field name="tf_dte_cl_state"/>
                            <field name="tf_dte_cl_emission_date"/>
                            <field name="tf_dte_cl_caf_id"/>
                        </group>
                        <group>
                            <field name="tf_dte_cl_envelope_id"/>
                            <field name="tf_dte_cl_track_id"/>
                            <field name="tf_dte_cl_sii_code"/>
                            <field name="tf_dte_cl_sii_detail"/>
                            <field name="tf_dte_cl_xml_file" filename="tf_dte_cl_xml_filename"/>
                            <field name="tf_dte_cl_xml_filename" invisible="1"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <record id="vpicktree_tf_dte_cl" model="ir.ui.view">
        <field name="name">stock.picking.list.tf_dte_cl</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="/list" position="inside">
                <field name="tf_dte_cl_folio" optional="show"/>
                <field name="tf_dte_cl_state" optional="show" widget="badge"
                       decoration-success="tf_dte_cl_state in ('accepted', 'accepted_objections')"
                       decoration-info="tf_dte_cl_state in ('signed', 'sent')"
                       decoration-warning="tf_dte_cl_state == 'send_unknown'"
                       decoration-danger="tf_dte_cl_state in ('rejected', 'error')"/>
            </xpath>
        </field>
    </record>

</odoo>
