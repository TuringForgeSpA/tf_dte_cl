<?xml version="1.0" encoding="utf-8"?>
<!-- Ruta real: views/envelope_views.xml -->
<odoo>

    <record id="view_tf_dte_cl_envelope_form" model="ir.ui.view">
        <field name="name">tf_dte_cl.envelope.form</field>
        <field name="model">tf_dte_cl.envelope</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_document" type="object" class="oe_stat_button"
                                icon="fa-file-text-o" string="Documento" invisible="not res_id"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Documento">
                            <field name="document_type"/>
                            <field name="folio"/>
                            <field name="res_model" invisible="1"/>
                            <field name="res_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Envío">
                            <field name="track_id"/>
                            <field name="date_sent"/>
                            <field name="upload_status"/>
                            <field name="confirmed_attempts"/>
                            <field name="xml_file" filename="xml_filename"/>
                            <field name="xml_filename" invisible="1"/>
                        </group>
                    </group>
                    <group string="Consulta al SII">
                        <field name="sii_code"/>
                        <field name="sii_detail"/>
                        <field name="last_query"/>
                        <field name="query_count"/>
                        <field name="last_message"/>
                    </group>
                    <notebook>
                        <page string="Intentos de envío" name="attempts">
                            <field name="attempt_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="create_uid"/>
                                </list>
                            </field>
                        </page>
                        <page string="Última respuesta del SII" name="response" invisible="not sii_response">
                            <field name="sii_response" widget="code" options="{'mode': 'xml'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tf_dte_cl_envelope_list" model="ir.ui.view">
        <field name="name">tf_dte_cl.envelope.list</field>
        <field name="model">tf_dte_cl.envelope</field>
        <field name="arch" type="xml">
            <list create="false" decoration-danger="state == 'failed'" decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="document_type"/>
                <field name="folio"/>
                <field name="track_id"/>
                <field name="date_sent"/>
                <field name="sii_code"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent'" decoration-danger="state == 'failed'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_tf_dte_cl_envelope_search" model="ir.ui.view">
        <field name="name">tf_dte_cl.envelope.search</field>
        <field name="model">tf_dte_cl.envelope</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="track_id"/>
                <field name="folio"/>
                <filter name="draft" string="Sin enviar" domain="[('state', '=', 'draft')]"/>
                <filter name="failed" string="Carga rechazada" domain="[('state', '=', 'failed')]"/>
                <group>
                    <filter name="group_type" string="Tipo de documento" context="{'group_by': 'document_type'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tf_dte_cl_envelope" model="ir.actions.act_window">
        <field name="name">Sobres de envío SII</field>
        <field name="res_model">tf_dte_cl.envelope</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
