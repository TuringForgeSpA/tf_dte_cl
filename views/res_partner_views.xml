<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_tf_dte_cl" model="ir.ui.view">
        <field name="name">res.partner.form.tf.dte.cl</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="city" position="after">
                <field name="comuna_id" placeholder="Comuna"/>
            </field>
            <field name="vat" position="after">
                <field name="giro" placeholder="Giro"/>
            </field>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="transportista"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_tree_tf_dte_cl" model="ir.ui.view">
        <field name="name">res.partner.tree.tf.dte.cl</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="display_name" position="after">
                <field name="giro" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
