<?xml version="1.0" encoding="utf-8"?>
<!-- Ruta real: views/certificate_views.xml -->
<odoo>

    <record id="view_tf_dte_cl_certificate_form" model="ir.ui.view">
        <field name="name">tf_dte_cl.certificate.form</field>
        <field name="model">tf_dte_cl.certificate</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="valid,expiring,expired"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Titular">
                            <field name="subject_name"/>
                            <field name="subject_email"/>
                            <field name="signer_rut" required="1"/>
                            <field name="has_key"/>
                        </group>
                        <group string="Vigencia">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="issuer_name"/>
                            <field name="serial_number"/>
                        </group>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        <field name="responsible_id"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_tf_dte_cl_certificate_list" model="ir.ui.view">
        <field name="name">tf_dte_cl.certificate.list</field>
        <field name="model">tf_dte_cl.certificate</field>
        <field name="arch" type="xml">
            <list create="false" decoration-danger="state == 'expired'"
                  decoration-warning="state == 'expiring'" decoration-success="state == 'valid'">
                <field name="name"/>
                <field name="subject_name"/>
                <field name="signer_rut"/>
                <field name="date_end"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_tf_dte_cl_certificate" model="ir.actions.act_window">
        <field name="name">Certificados digitales</field>
        <field name="res_model">tf_dte_cl.certificate</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_tf_dte_cl_certificate_load_form" model="ir.ui.view">
        <field name="name">tf_dte_cl.certificate.load.form</field>
        <field name="model">tf_dte_cl.certificate.load</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="p12_file" filename="p12_filename"/>
                    <field name="p12_filename" invisible="1"/>
                    <field name="password" password="True"/>
                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    <field name="make_default"/>
                </group>
                <p class="text-muted">
                    El archivo y la contraseña no se guardan: solo se conservan el certificado y la llave
                    extraídos, visibles únicamente para administradores del sistema.
                </p>
                <footer>
                    <button name="action_load" type="object" string="Cargar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tf_dte_cl_certificate_load" model="ir.actions.act_window">
        <field name="name">Cargar certificado digital</field>
        <field name="res_model">tf_dte_cl.certificate.load</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
