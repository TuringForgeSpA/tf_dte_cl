<?xml version="1.0" encoding="utf-8"?>
<!-- Ruta real: views/caf_views.xml -->
<odoo>

    <record id="view_tf_dte_cl_caf_form" model="ir.ui.view">
        <field name="name">tf_dte_cl.caf.form</field>
        <field name="model">tf_dte_cl.caf</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="available,exhausted,expired"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" invisible="not id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="caf_file" filename="caf_filename" readonly="id"/>
                            <field name="caf_filename" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="id"
                                   options="{'no_create': True}"/>
                            <field name="document_type" invisible="not id"/>
                            <field name="rut" invisible="not id"/>
                            <field name="idk" invisible="not id"/>
                            <field name="environment" invisible="not id"/>
                        </group>
                        <group invisible="not id">
                            <field name="folio_from"/>
                            <field name="folio_to"/>
                            <field name="next_folio"/>
                            <field name="folios_available"/>
                            <field name="date_authorized"/>
                            <field name="date_expiry"/>
                            <field name="exhausted" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook invisible="not id">
                        <page string="Folios por anular" name="voids">
                            <field name="void_ids" readonly="1">
                                <list>
                                    <field name="folio"/>
                                    <field name="reason"/>
                                    <field name="state" widget="badge"
                                           decoration-warning="state == 'pending'"
                                           decoration-success="state == 'done'"/>
                                    <field name="date_done"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_tf_dte_cl_caf_list" model="ir.ui.view">
        <field name="name">tf_dte_cl.caf.list</field>
        <field name="model">tf_dte_cl.caf</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('exhausted', 'archived')"
                  decoration-danger="state == 'expired'"
                  decoration-warning="state == 'available' and folios_available &lt;= 10">
                <field name="document_type"/>
                <field name="environment" widget="badge" decoration-success="environment == 'produccion'" decoration-info="environment == 'certificacion'"/>
                <field name="folio_from"/>
                <field name="folio_to"/>
                <field name="next_folio"/>
                <field name="folios_available"/>
                <field name="date_authorized"/>
                <field name="date_expiry"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_tf_dte_cl_caf_search" model="ir.ui.view">
        <field name="name">tf_dte_cl.caf.search</field>
        <field name="model">tf_dte_cl.caf</field>
        <field name="arch" type="xml">
            <search>
                <field name="document_type"/>
                <filter name="with_folios" string="Con folios" domain="[('exhausted', '=', False)]"/>
                <filter name="archived" string="Archivados" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Tipo de documento" context="{'group_by': 'document_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tf_dte_cl_caf" model="ir.actions.act_window">
        <field name="name">CAF</field>
        <field name="res_model">tf_dte_cl.caf</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_with_folios': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cargue un archivo CAF descargado desde el SII</p>
            <p>Cada CAF autoriza un rango de folios para un tipo de documento.</p>
        </field>
    </record>

    <record id="view_tf_dte_cl_caf_void_list" model="ir.ui.view">
        <field name="name">tf_dte_cl.caf.void.list</field>
        <field name="model">tf_dte_cl.caf.void</field>
        <field name="arch" type="xml">
            <list create="false" decoration-warning="state == 'pending'">
                <field name="document_type"/>
                <field name="folio"/>
                <field name="reason"/>
                <field name="res_model" optional="hide"/>
                <field name="res_id" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="date_done"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <button name="action_mark_done" type="object" string="Marcar anulado"
                        icon="fa-check" invisible="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_tf_dte_cl_caf_void_search" model="ir.ui.view">
        <field name="name">tf_dte_cl.caf.void.search</field>
        <field name="model">tf_dte_cl.caf.void</field>
        <field name="arch" type="xml">
            <search>
                <field name="folio"/>
                <filter name="pending" string="Pendientes" domain="[('state', '=', 'pending')]"/>
                <group>
                    <filter name="group_type" string="Tipo de documento" context="{'group_by': 'document_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tf_dte_cl_caf_void" model="ir.actions.act_window">
        <field name="name">Folios por anular</field>
        <field name="res_model">tf_dte_cl.caf.void</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay folios pendientes de anulación</p>
            <p>Aquí aparecen los folios que se firmaron pero nunca llegaron al SII.
               Anúlelos en el sitio del SII y márquelos como anulados.</p>
        </field>
    </record>

</odoo>
