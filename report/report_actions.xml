<?xml version="1.0" encoding="utf-8"?>
<!-- Ruta real: report/report_actions.xml -->
<odoo>

    <record id="action_report_move_dte" model="ir.actions.report">
        <field name="name">DTE (A4)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tf_dte_cl.report_move_dte</field>
        <field name="report_file">tf_dte_cl.report_move_dte</field>
        <field name="print_report_name">'DTE_T%s_F%s' % (object.tf_dte_cl_document_type, object.tf_dte_cl_folio)</field>
        <field name="paperformat_id" ref="tf_dte_cl.paperformat_tf_dte_cl_a4"/>
        <!-- Sin binding: Imprimir y Descargar > PDF ya usan el formato DTE. -->
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="action_report_move_dte_thermal" model="ir.actions.report">
        <field name="name">DTE (térmico)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tf_dte_cl.report_move_dte_thermal</field>
        <field name="report_file">tf_dte_cl.report_move_dte_thermal</field>
        <field name="print_report_name">'DTE_T%s_F%s' % (object.tf_dte_cl_document_type, object.tf_dte_cl_folio)</field>
        <field name="paperformat_id" ref="tf_dte_cl.paperformat_tf_dte_cl_thermal"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_picking_dte" model="ir.actions.report">
        <field name="name">Guía de despacho (A4)</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tf_dte_cl.report_picking_dte</field>
        <field name="report_file">tf_dte_cl.report_picking_dte</field>
        <field name="print_report_name">'GUIA_F%s' % object.tf_dte_cl_folio</field>
        <field name="paperformat_id" ref="tf_dte_cl.paperformat_tf_dte_cl_a4"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_picking_dte_thermal" model="ir.actions.report">
        <field name="name">Guía de despacho (térmico)</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tf_dte_cl.report_picking_dte_thermal</field>
        <field name="report_file">tf_dte_cl.report_picking_dte_thermal</field>
        <field name="print_report_name">'GUIA_F%s' % object.tf_dte_cl_folio</field>
        <field name="paperformat_id" ref="tf_dte_cl.paperformat_tf_dte_cl_thermal"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
