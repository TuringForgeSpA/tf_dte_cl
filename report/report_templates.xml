<?xml version="1.0" encoding="utf-8"?>
<!-- Ruta real: report/report_templates.xml
     Representación impresa de facturas, notas y guías. Antes de certificar,
     revisar contra el "Manual de muestras impresas" vigente del SII. -->
<odoo>

    <!-- ============================================================
         Bloques compartidos (esperan "o" y "company" en el contexto)
         ============================================================ -->

    <template id="dte_header">
        <div class="row mb-3">
            <div class="col-7">
                <img t-if="company.tf_dte_cl_print_logo and company.logo"
                     t-att-src="image_data_uri(company.logo)" style="max-height: 60px;" alt="Logo"/>
                <h5 class="mt-2 mb-0 text-uppercase fw-bold" t-out="company.name"/>
                <div class="small text-uppercase" t-out="company.tf_dte_cl_giro"/>
                <div class="small">
                    <span t-out="company.street"/>
                    <t t-if="company.tf_dte_cl_comuna_id">, <span t-out="company.tf_dte_cl_comuna_id.name"/></t>
                    <t t-if="company.city">, <span t-out="company.city"/></t>
                </div>
                <t t-set="branch" t-value="o._tf_dte_cl_get_branch()"/>
                <div class="small" t-if="branch and branch.street">
                    Sucursal: <span t-out="branch.street"/>
                    <t t-if="branch.comuna_id">, <span t-out="branch.comuna_id.name"/></t>
                    <t t-if="branch.city">, <span t-out="branch.city"/></t>
                </div>
                <div class="small">
                    <t t-if="company.phone">Teléfono: <span t-out="company.phone"/></t>
                    <t t-if="company.tf_dte_cl_dte_email or company.email">
                        · <span t-out="company.tf_dte_cl_dte_email or company.email"/>
                    </t>
                </div>
            </div>
            <div class="col-5 text-center">
                <div style="border: 3px solid #d00; color: #d00; padding: 8px;">
                    <div class="fw-bold fs-5">R.U.T.: <span t-out="o._tf_dte_cl_format_rut(company.vat)"/></div>
                    <div class="fw-bold fs-5 text-uppercase" t-out="o._tf_dte_cl_document_name()"/>
                    <div class="fw-bold fs-5">N° <span t-out="o.tf_dte_cl_folio"/></div>
                </div>
                <div class="small text-uppercase mt-1" style="color: #d00;" t-out="company.tf_dte_cl_sii_office"/>
            </div>
        </div>
    </template>

    <template id="dte_receiver">
        <t t-set="receiver" t-value="o._tf_dte_cl_get_receiver()"/>
        <t t-set="commercial" t-value="receiver.commercial_partner_id"/>
        <table class="table table-sm table-borderless border border-dark mb-3 small">
            <tr>
                <td class="fw-bold" style="width: 18%;">Señor(es):</td>
                <td style="width: 42%;" t-out="commercial.name"/>
                <td class="fw-bold" style="width: 18%;">Fecha emisión:</td>
                <td t-out="o.tf_dte_cl_emission_date" t-options="{'widget': 'date'}"/>
            </tr>
            <tr>
                <td class="fw-bold">R.U.T.:</td>
                <td t-out="o._tf_dte_cl_format_rut(commercial.vat)"/>
                <td class="fw-bold">Comuna:</td>
                <td t-out="receiver.tf_dte_cl_comuna_id.name"/>
            </tr>
            <tr>
                <td class="fw-bold">Dirección:</td>
                <td><span t-out="receiver.street"/> <span t-out="receiver.street2"/></td>
                <td class="fw-bold">Ciudad:</td>
                <td t-out="receiver.city"/>
            </tr>
            <tr>
                <td class="fw-bold">Giro:</td>
                <td t-out="commercial.tf_dte_cl_giro"/>
                <t t-out="0"/>
            </tr>
        </table>
    </template>

    <template id="dte_references">
        <t t-set="references" t-value="o._tf_dte_cl_get_references()"/>
        <table t-if="references" class="table table-sm border border-dark mb-3 small">
            <thead>
                <tr><th>Documento de referencia</th><th>Folio</th><th>Fecha</th><th>Motivo</th></tr>
            </thead>
            <tbody>
                <tr t-foreach="references" t-as="ref">
                    <td t-out="ref.document_type_id.name"/>
                    <td t-out="ref.folio"/>
                    <td t-out="ref.date" t-options="{'widget': 'date'}"/>
                    <td>
                        <t t-if="ref.code"><span t-field="ref.code"/><t t-if="ref.reason">: </t></t>
                        <span t-out="ref.reason"/>
                    </td>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="dte_lines">
        <table class="table table-sm small">
            <thead>
                <tr>
                    <th>Código</th><th>Detalle</th><th class="text-end">Cantidad</th>
                    <th>Unidad</th><th class="text-end">Precio</th>
                    <th class="text-end">Desc. %</th><th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="o._tf_dte_cl_line_infos()" t-as="line">
                    <td t-out="line.default_code"/>
                    <td>
                        <span t-out="line.product_name"/>
                        <t t-if="line.is_exempt"> <em>(exento)</em></t>
                        <div t-if="line.description and line.description != line.product_name"
                             class="text-muted" t-out="line.description"/>
                    </td>
                    <td class="text-end" t-out="line.quantity"/>
                    <td t-out="line.uom"/>
                    <td class="text-end" t-out="o._tf_dte_cl_format_amount(line.price_unit)"/>
                    <td class="text-end"><t t-if="line.discount" t-out="line.discount"/></td>
                    <td class="text-end" t-out="o._tf_dte_cl_format_amount(line.subtotal)"/>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="dte_footer">
        <div class="row mt-3">
            <div class="col-6 text-center">
                <t t-if="o.tf_dte_cl_barcode">
                    <img t-att-src="image_data_uri(o.tf_dte_cl_barcode)" style="max-width: 100%;" alt="Timbre electrónico"/>
                    <div class="small">Timbre Electrónico SII</div>
                    <div class="small"><span t-out="o._tf_dte_cl_resolution_text()"/> · Verifique documento: www.sii.cl</div>
                </t>
            </div>
            <div class="col-5 offset-1">
                <table class="table table-sm small">
                    <tr t-foreach="o._tf_dte_cl_print_totals()" t-as="row"
                        t-attf-class="{{ 'fw-bold border-top border-dark' if row_last else '' }}">
                        <td t-out="row[0]"/>
                        <td class="text-end" t-out="o._tf_dte_cl_format_amount(row[1])"/>
                    </tr>
                </table>
            </div>
        </div>
    </template>

    <template id="dte_thermal_body">
        <div style="font-size: 10px; width: 100%;">
            <div class="text-center">
                <div class="fw-bold text-uppercase" t-out="company.name"/>
                <div>R.U.T.: <span t-out="o._tf_dte_cl_format_rut(company.vat)"/></div>
                <div class="fw-bold text-uppercase" t-out="o._tf_dte_cl_document_name()"/>
                <div class="fw-bold">N° <span t-out="o.tf_dte_cl_folio"/></div>
                <div class="text-uppercase" t-out="company.tf_dte_cl_sii_office"/>
            </div>
            <t t-set="receiver" t-value="o._tf_dte_cl_get_receiver().commercial_partner_id"/>
            <div class="mt-2">
                <div>Fecha: <span t-out="o.tf_dte_cl_emission_date" t-options="{'widget': 'date'}"/></div>
                <div>Señor(es): <span t-out="receiver.name"/></div>
                <div>R.U.T.: <span t-out="o._tf_dte_cl_format_rut(receiver.vat)"/></div>
            </div>
            <table style="width: 100%;" class="mt-2">
                <tr t-foreach="o._tf_dte_cl_line_infos()" t-as="line">
                    <td><span t-out="line.quantity"/> x <span t-out="line.product_name"/></td>
                    <td class="text-end" t-out="o._tf_dte_cl_format_amount(line.subtotal)"/>
                </tr>
            </table>
            <table style="width: 100%;" class="mt-2">
                <tr t-foreach="o._tf_dte_cl_print_totals()" t-as="row"
                    t-attf-class="{{ 'fw-bold' if row_last else '' }}">
                    <td t-out="row[0]"/>
                    <td class="text-end" t-out="o._tf_dte_cl_format_amount(row[1])"/>
                </tr>
            </table>
            <div class="text-center mt-2" t-if="o.tf_dte_cl_barcode">
                <img t-att-src="image_data_uri(o.tf_dte_cl_barcode)" style="max-width: 100%;" alt="Timbre electrónico"/>
                <div>Timbre Electrónico SII</div>
                <div><span t-out="o._tf_dte_cl_resolution_text()"/> · Verifique documento: www.sii.cl</div>
            </div>
        </div>
    </template>

    <!-- ============================================================
         Facturas y notas
         ============================================================ -->

    <template id="report_move_dte_document">
        <t t-call="web.basic_layout">
            <t t-set="company" t-value="o.company_id"/>
            <div class="page">
                <t t-call="tf_dte_cl.dte_header"/>
                <t t-call="tf_dte_cl.dte_receiver">
                    <td class="fw-bold">Condición de pago:</td>
                    <td>
                        <t t-if="o.invoice_date_due and o.invoice_date_due &gt; o.tf_dte_cl_emission_date">
                            Crédito, vence <span t-out="o.invoice_date_due" t-options="{'widget': 'date'}"/>
                        </t>
                        <t t-else="">Contado</t>
                    </td>
                </t>
                <t t-call="tf_dte_cl.dte_references"/>
                <t t-call="tf_dte_cl.dte_lines"/>
                <div t-if="o.narration" class="small border p-2" t-field="o.narration"/>
                <t t-call="tf_dte_cl.dte_footer"/>
            </div>
        </t>
    </template>

    <template id="report_move_dte">
        <t t-call="web.html_container">
            <t t-foreach="docs.filtered('tf_dte_cl_folio')" t-as="o">
                <t t-call="tf_dte_cl.report_move_dte_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <template id="report_move_dte_thermal">
        <t t-call="web.html_container">
            <t t-foreach="docs.filtered('tf_dte_cl_folio')" t-as="o">
                <t t-set="company" t-value="o.company_id"/>
                <div class="page"><t t-call="tf_dte_cl.dte_thermal_body"/></div>
            </t>
        </t>
    </template>

    <!-- ============================================================
         Guías de despacho
         ============================================================ -->

    <template id="report_picking_dte_document">
        <t t-call="web.basic_layout">
            <t t-set="company" t-value="o.company_id"/>
            <div class="page">
                <t t-call="tf_dte_cl.dte_header"/>
                <t t-call="tf_dte_cl.dte_receiver">
                    <td class="fw-bold">Traslado:</td>
                    <td t-field="o.tf_dte_cl_transfer_type"/>
                </t>
                <table class="table table-sm table-borderless border border-dark mb-3 small">
                    <tr>
                        <td class="fw-bold" style="width: 18%;">Despacho:</td>
                        <td style="width: 42%;" t-field="o.tf_dte_cl_dispatch_type"/>
                        <td class="fw-bold" style="width: 18%;">Patente:</td>
                        <td t-out="o.tf_dte_cl_vehicle_plate"/>
                    </tr>
                    <tr>
                        <td class="fw-bold">Destino:</td>
                        <td>
                            <span t-out="o.tf_dte_cl_dest_street"/>,
                            <span t-out="o.tf_dte_cl_dest_comuna_id.name"/>
                            <t t-if="o.tf_dte_cl_dest_city">, <span t-out="o.tf_dte_cl_dest_city"/></t>
                        </td>
                        <td class="fw-bold">Transportista:</td>
                        <td>
                            <span t-out="o.tf_dte_cl_carrier_id.name"/>
                            <t t-if="o.tf_dte_cl_driver_name"> · Chofer: <span t-out="o.tf_dte_cl_driver_name"/></t>
                        </td>
                    </tr>
                </table>
                <t t-call="tf_dte_cl.dte_references"/>
                <t t-call="tf_dte_cl.dte_lines"/>
                <t t-call="tf_dte_cl.dte_footer"/>
                <table class="table table-sm border border-dark small mt-3">
                    <tr><td style="width: 50%;">Nombre:</td><td>R.U.T.:</td></tr>
                    <tr><td>Fecha:</td><td>Recinto:</td></tr>
                    <tr><td colspan="2" style="height: 40px;">Firma:</td></tr>
                </table>
            </div>
        </t>
    </template>

    <template id="report_picking_dte">
        <t t-call="web.html_container">
            <t t-foreach="docs.filtered('tf_dte_cl_folio')" t-as="o">
                <t t-call="tf_dte_cl.report_picking_dte_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <template id="report_picking_dte_thermal">
        <t t-call="web.html_container">
            <t t-foreach="docs.filtered('tf_dte_cl_folio')" t-as="o">
                <t t-set="company" t-value="o.company_id"/>
                <div class="page"><t t-call="tf_dte_cl.dte_thermal_body"/></div>
            </t>
        </t>
    </template>

</odoo>
