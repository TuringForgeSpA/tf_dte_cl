<?xml version="1.0" encoding="utf-8"?>
<!-- Ruta real: data/tf_dte_cl_cron.xml -->
<odoo noupdate="1">

    <!-- account_edi dispara su propio envío al publicar, pero su cron
         (ir_cron_edi_network) viene inactivo en Odoo 18: los reintentos
         quedarían detenidos. Este cron envía los DTE firmados pendientes. -->
    <record id="ir_cron_tf_dte_cl_send_moves" model="ir.cron">
        <field name="name">DTE: enviar facturas y notas pendientes al SII</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_tf_dte_cl_send()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_tf_dte_cl_query_moves" model="ir.cron">
        <field name="name">DTE: consultar estado de facturas y notas en el SII</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_tf_dte_cl_query()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_tf_dte_cl_certificate_expiry" model="ir.cron">
        <field name="name">DTE: alerta de vencimiento de certificados digitales</field>
        <field name="model_id" ref="model_tf_dte_cl_certificate"/>
        <field name="state">code</field>
        <field name="code">model._cron_tf_dte_cl_expiry_alert()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <!-- Guías de despacho: no usan account_edi, tienen sus propios crons. -->
    <record id="ir_cron_tf_dte_cl_send_pickings" model="ir.cron">
        <field name="name">DTE: enviar guías de despacho pendientes al SII</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model._cron_tf_dte_cl_send()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_tf_dte_cl_query_pickings" model="ir.cron">
        <field name="name">DTE: consultar estado de guías de despacho en el SII</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model._cron_tf_dte_cl_query()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

</odoo>
